-- =======================================================================
-- GERENCIAMENTO DE ESTADOS (ANTI-SIT PERSISTENTE)
-- =======================================================================
local antiSitConnections = {}

local function resetSitting()
    for _, conn in ipairs(antiSitConnections) do if conn and conn.Connected then conn:Disconnect() end end
    antiSitConnections = {}
    local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
    if hum then hum:SetStateEnabled(Enum.HumanoidStateType.Seated, true) end
end

local function activateAntiSit()
    resetSitting()
    local function preventSitting(humanoid)
        if not humanoid then return end
        if humanoid.Sit then humanoid.Sit = false humanoid:ChangeState(Enum.HumanoidStateType.GettingUp) end
        humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, false)
        table.insert(antiSitConnections, humanoid.StateChanged:Connect(function(_, newState)
            if newState == Enum.HumanoidStateType.Seated and CoreGui:GetAttribute("GlobalAntiSitActive") then
                humanoid.Sit = false humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
            end
        end))
    end
    table.insert(antiSitConnections, LocalPlayer.CharacterAdded:Connect(function(char) preventSitting(char:WaitForChild("Humanoid")) end))
    if LocalPlayer.Character then preventSitting(LocalPlayer.Character:FindFirstChildOfClass("Humanoid")) end
end

RunService.Heartbeat:Connect(function()
    if CoreGui:GetAttribute("GlobalAntiSitActive") then
        local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hum then 
            hum:SetStateEnabled(Enum.HumanoidStateType.Seated, false) 
            if hum.Sit then hum.Sit = false end 
        end
    end
end)

CoreGui:GetAttributeChangedSignal("GlobalAntiSitActive"):Connect(function()
    if CoreGui:GetAttribute("GlobalAntiSitActive") then activateAntiSit() else resetSitting() end
end)

if CoreGui:GetAttribute("GlobalAntiSitActive") then activateAntiSit() end

-- =======================================================================
-- LÓGICA DO SMART FREEZE (COM 1 SEGUNDO DE ESPERA APÓS PARAR)
-- =======================================================================
local idleStartTime = nil

RunService.Heartbeat:Connect(function()
    if CoreGui:GetAttribute("GlobalFreezeActive") then
        local char = LocalPlayer.Character
        if char then
            local rootPart = char:FindFirstChild("HumanoidRootPart")
            local hum = char:FindFirstChildOfClass("Humanoid")
            if rootPart and hum then
                if hum.MoveDirection.Magnitude > 0 then
                    -- Se estiver se movendo, destrava na hora e reseta o cronômetro
                    if rootPart.Anchored then
                        rootPart.Anchored = false
                    end
                    idleStartTime = nil
                else
                    -- Se parou de se mover, aguarda 1 segundo completo antes de ancorar
                    if not rootPart.Anchored then
                        if idleStartTime == nil then
                            idleStartTime = os.clock()
                        elseif (os.clock() - idleStartTime) >= 1.0 then
                            rootPart.Anchored = true
                        end
                    end
                end
            end
        end
    end
end)

CoreGui:GetAttributeChangedSignal("GlobalFreezeActive"):Connect(function()
    if not CoreGui:GetAttribute("GlobalFreezeActive") then
        idleStartTime = nil
        local char = LocalPlayer.Character
        if char then
            local rootPart = char:FindFirstChild("HumanoidRootPart")
            if rootPart then rootPart.Anchored = false end
        end
    end
end)

-- =======================================================================
-- LÓGICA DO ANTI-COLISÃO / ANTI-FLING PERSISTENTE
-- =======================================================================
local antiCollisionData = {} 
local antiCollisionConnection = nil

local function processarPartAntiColisao(part)
    if not CoreGui:GetAttribute("GlobalAntiCollisionActive") then return end
    if part:IsA("BasePart") and not part.Anchored and antiCollisionData[part] == nil then
        antiCollisionData[part] = part.CanCollide 
        part.CanCollide = false
    end
end

local function desativarAntiColisao()
    if antiCollisionConnection then
        antiCollisionConnection:Disconnect()
        antiCollisionConnection = nil
    end
    for part, originalCanCollide in pairs(antiCollisionData) do
        if part and part.Parent then
            pcall(function()
                part.CanCollide = originalCanCollide 
            end)
        end
    end
    antiCollisionData = {}
end

local function ativarAntiColisao()
    desativarAntiColisao()
    for _, objeto in ipairs(workspace:GetDescendants()) do
        processarPartAntiColisao(objeto)
    end
    antiCollisionConnection = workspace.DescendantAdded:Connect(function(objeto)
        processarPartAntiColisao(objeto)
    end)
end

local function sincronizarAntiColisao()
    if CoreGui:GetAttribute("GlobalAntiCollisionActive") then
        ativarAntiColisao()
    else
        desativarAntiColisao()
    end
end

CoreGui:GetAttributeChangedSignal("GlobalAntiCollisionActive"):Connect(sincronizarAntiColisao)
if CoreGui:GetAttribute("GlobalAntiCollisionActive") then task.spawn(sincronizarAntiColisao) end

-- =======================================================================
-- LÓGICA DO ANTI-LAG BOMB (OTIMIZADA ESTILO BANANA - SEM LOOPS DE TRAVAMENTO)
-- =======================================================================
local ItensDaBomba = { ["Bomb"] = true, ["NukeBomb1"] = true, ["NukeBomb2"] = true, ["sire1"] = true, ["Fire"] = true }
local ClassesDoLag = { ["Sound"] = true, ["ParticleEmitter"] = true, ["Explosion"] = true }

local function neutralizarBomba(objeto)
    if not CoreGui:GetAttribute("GlobalAntiLagActive") or not objeto or not objeto.Parent then return end
    if LocalPlayer.Character and objeto:IsDescendantOf(LocalPlayer.Character) then return end

    local nome, classe = objeto.Name, objeto.ClassName

    if ItensDaBomba[nome] or ClassesDoLag[classe] then
        local touchInterest = objeto:FindFirstChildOfClass("TouchInterest")
        if touchInterest then touchInterest:Destroy() end

        if objeto:IsA("BasePart") and nome ~= "Fire" then
            objeto.Transparency, objeto.CanCollide, objeto.Size = 1, false, Vector3.zero
        elseif ClassesDoLag[classe] or nome == "Fire" or nome == "sire1" then
            if objeto:IsA("Sound") then objeto.Volume = 0 objeto:Stop() end
            pcall(function() objeto:Destroy() end)
        end
    end
end

workspace.DescendantAdded:Connect(neutralizarBomba)

local function aplicarAntiLagInicial()
    if CoreGui:GetAttribute("GlobalAntiLagActive") then
        local descendants = workspace:GetDescendants()
        for i = 1, #descendants do
            neutralizarBomba(descendants[i])
        end
    end
end

CoreGui:GetAttributeChangedSignal("GlobalAntiLagActive"):Connect(aplicarAntiLagInicial)
if CoreGui:GetAttribute("GlobalAntiLagActive") then task.spawn(aplicarAntiLagInicial) end

-- =======================================================================
-- LÓGICA DO ALCANCE INFINITO PERSISTENTE (CLICK 1E30)
-- =======================================================================
local DISTANCIA_DESPERTADA = math.huge
local clickConnection = nil

local function expandirBotoesExistentes(estado)
    local distancia = estado and DISTANCIA_DESPERTADA or 32
    for _, objeto in pairs(workspace:GetDescendants()) do
        if objeto:IsA("ClickDetector") or objeto:IsA("ProximityPrompt") then
            objeto.MaxActivationDistance = distancia
        end
    end
end

local function gerenciarClick1e30()
    local ativo = CoreGui:GetAttribute("GlobalClickActive")
    if clickConnection then clickConnection:Disconnect() clickConnection = nil end

    if ativo then
        expandirBotoesExistentes(true)
        clickConnection = workspace.DescendantAdded:Connect(function(objeto)
            if objeto:IsA("ClickDetector") or objeto:IsA("ProximityPrompt") then
                objeto.MaxActivationDistance = DISTANCIA_DESPERTADA
            end
        end)

        if sethp then
            task.spawn(function()
                while CoreGui:GetAttribute("GlobalClickActive") do
                    pcall(function()
                        sethp(LocalPlayer, "SimulationRadius", 1e30)
                        sethp(LocalPlayer, "MaxSimulationRadius", 1e30)
                    end)
                    RunService.RenderStepped:Wait()
                end
            end)
        end
    else
        expandirBotoesExistentes(false)
    end
end

CoreGui:GetAttributeChangedSignal("GlobalClickActive"):Connect(gerenciarClick1e30)
if CoreGui:GetAttribute("GlobalClickActive") then task.spawn(gerenciarClick1e30) end

