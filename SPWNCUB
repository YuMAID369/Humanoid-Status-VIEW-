-- GERENCIAMENTO DE ESTADOS (ANTI-LAG & ANTI-SIT)
-- =======================================================================
local antiLagActive, antiSitActive = false, false
local antiSitConnections = {}

local ItensDaBomba = { ["Bomb"] = true, ["NukeBomb1"] = true, ["NukeBomb2"] = true, ["sire1"] = true, ["Fire"] = true }
local ClassesDoLag = { ["Sound"] = true, ["ParticleEmitter"] = true, ["Explosion"] = true }

local function neutralizarBomba(objeto)
    if not objeto or not objeto.Parent or (LocalPlayer.Character and objeto:IsDescendantOf(LocalPlayer.Character)) then return end
    local nome, classe = objeto.Name, objeto.ClassName

    if ItensDaBomba[nome] then
        if objeto:IsA("BasePart") and nome ~= "Fire" then
            objeto.Transparency, objeto.CanCollide, objeto.Size = 1, false, Vector3.zero
        elseif ClassesDoLag[classe] or nome == "Fire" or nome == "sire1" then
            if objeto:IsA("Sound") then objeto.Volume = 0 objeto:Stop() end
            objeto:Destroy()
        end
    elseif ClassesDoLag[classe] and (objeto.Parent.Name == "Handle" or ItensDaBomba[objeto.Parent.Name]) then
        if objeto:IsA("Sound") then objeto.Volume = 0 objeto:Stop() end
        objeto:Destroy()
    end
end

workspace.DescendantAdded:Connect(function(desc) if antiLagActive then neutralizarBomba(desc) end end)

task.spawn(function()
    while task.wait(0.2) do
        if antiLagActive then
            for _, obj in ipairs(workspace:GetDescendants()) do neutralizarBomba(obj) end
            for _, jogador in ipairs(Players:GetPlayers()) do
                if jogador ~= LocalPlayer and jogador.Character then
                    for _, ferramenta in ipairs(jogador.Character:GetChildren()) do
                        if ferramenta:IsA("Tool") and ItensDaBomba[ferramenta.Name] then neutralizarBomba(ferramenta) end
                    end
                end
            end
        end
    end
end)

local function resetSitting()
    for _, conn in ipairs(antiSitConnections) do if conn and conn.Connected then conn:Disconnect() end end
    antiSitConnections = {}
    local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
    if hum then hum:SetStateEnabled(Enum.HumanoidStateType.Seated, true) end
end

local function activateAntiSit()
    resetSitting()
    local function preventSitting(humanoid)
        if not humanoid then return end
        if humanoid.Sit then humanoid.Sit = false humanoid:ChangeState(Enum.HumanoidStateType.GettingUp) end
        humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, false)
        table.insert(antiSitConnections, humanoid.StateChanged:Connect(function(_, newState)
            if newState == Enum.HumanoidStateType.Seated then
                humanoid.Sit = false humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
            end
        end))
    end
    table.insert(antiSitConnections, LocalPlayer.CharacterAdded:Connect(function(char) preventSitting(char:WaitForChild("Humanoid")) end))
    if LocalPlayer.Character then preventSitting(LocalPlayer.Character:FindFirstChildOfClass("Humanoid")) end
end

RunService.Heartbeat:Connect(function()
    if antiSitActive then
        local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hum then hum:SetStateEnabled(Enum.HumanoidStateType.Seated, false) hum.Sit = false end
    end
end)

