OpenCloseIcon.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        draggingIcon, dragStartPos, startIconPos = true, input.Position, OpenCloseIcon.Position
        local currentTime = tick()
        if (currentTime - lastClickTime) < 0.35 then
            ScreenGui:Destroy() 
            return
        end
        lastClickTime = currentTime
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if draggingIcon and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStartPos
        OpenCloseIcon.Position = UDim2.new(startIconPos.X.Scale, startIconPos.X.Offset + delta.X, startIconPos.Y.Scale, startIconPos.Y.Offset + delta.Y)
    end
end)

OpenCloseIcon.InputEnded:Connect(function(input)
    if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) and draggingIcon then
        draggingIcon = false
        if (input.Position - dragStartPos).Magnitude < 5 then MainFrameBorder.Visible = not MainFrameBorder.Visible end
    end
end)

